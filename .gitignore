# Personal config / secrets — never shared
dot-claude/settings.local.json
dot-claude/**/settings.local.json

# Backups generated by install.sh
*.bak-*

# Skill dependencies — installed by install.sh (e.g. archify's ajv)
node_modules/

# Graphify — the /graphify skill files are installed per-machine by install.sh
# (not vendored), and graphify-out/ is its generated build output.
dot-claude/skills/graphify/
graphify-out/

# Generated diagram HTML — regenerate from the .json source with archify
docs/*-diagram.html

# Local-only reference guides (kept on disk, not in the repo)
docs/claude-engineering-layers.html

# OS / editor noise
.DS_Store
*.swp
.idea/
.vscode/

# Backups y symlinks que escriben Orca / los plugins por máquina (no vendorizar)
*.bak
dot-claude/skills/computer-use
dot-claude/skills/find-skills
dot-claude/skills/orca-cli
dot-claude/skills/orchestration
