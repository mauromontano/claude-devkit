    { "from": "review", "to": "fix", "label": "hallazgos", "variant": "security", "role": "error", "fromSide": "bottom", "toSide": "top", "route": "drop", "labelSegment": 1, "labelDy": 12 },
    { "from": "fix", "to": "stage", "label": "corregir", "variant": "dashed", "role": "branch", "fromSide": "left", "toSide": "bottom", "route": "return-left" }
