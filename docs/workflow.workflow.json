  "phases": [
    { "id": "p0", "label": "Entender + planear", "fromCol": 0, "toCol": 1 },
    { "id": "p1", "label": "Documentar + construir (TDD)", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "p2", "label": "Revisar + integrar", "fromCol": 4, "toCol": 5 }
  ],
  "mainPath": ["brainstorm", "plan", "docs", "stage", "review", "cierre"],
  "nodes": [
    { "id": "brainstorm", "lane": "design", "col": 0, "type": "external", "label": "Brainstorm", "sublabel": "/feature", "tag": "escala por complejidad" },
    { "id": "plan", "lane": "design", "col": 1, "type": "backend", "label": "Plan por capas", "sublabel": "plan mode", "tag": "architecture-planner" },
    { "id": "docs", "lane": "build", "col": 2, "type": "cloud", "label": "Spec+Docs", "sublabel": "/spec · /doc · /tasks", "tag": "scenarios + diagrama" },
    { "id": "stage", "lane": "build", "col": 3, "type": "backend", "label": "Etapa TDD", "sublabel": "/stage", "tag": "test-writer · rojo→verde" },
    { "id": "review", "lane": "review", "col": 4, "type": "security", "label": "Review", "sublabel": "/review", "tag": "code · security · verify" },
    { "id": "cierre", "lane": "review", "col": 5, "type": "backend", "label": "Cierre", "sublabel": "commit · archive" },
    { "id": "fix", "lane": "exceptions", "col": 4, "type": "messagebus", "label": "Resolver", "sublabel": "bloqueantes 🔴" }
