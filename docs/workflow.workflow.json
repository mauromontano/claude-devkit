{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "End-to-end feature process",
    "subtitle": "claude-devkit · brainstorm → plan → spec+docs → TDD → review+verify → close",
    "output": "docs/workflow-diagram.html"
  },
  "lanes": [
    { "id": "design", "label": "Design" },
    { "id": "build", "label": "Build" },
    { "id": "review", "label": "Review & Close" },
    { "id": "exceptions", "label": "If there are blockers", "variant": "exception" }
  ],
  "phases": [
    { "id": "p0", "label": "Understand + plan", "fromCol": 0, "toCol": 1 },
    { "id": "p1", "label": "Document + build (TDD)", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "p2", "label": "Review + integrate", "fromCol": 4, "toCol": 5 }
  ],
  "mainPath": ["brainstorm", "plan", "docs", "stage", "review", "close"],
  "nodes": [
    { "id": "brainstorm", "lane": "design", "col": 0, "type": "external", "label": "Brainstorm", "sublabel": "/feature", "tag": "scales with complexity" },
    { "id": "plan", "lane": "design", "col": 1, "type": "backend", "label": "Layered plan", "sublabel": "plan mode", "tag": "architect" },
    { "id": "docs", "lane": "build", "col": 2, "type": "cloud", "label": "Spec+Docs", "sublabel": "/spec · /doc · /tasks", "tag": "scenarios + diagram" },
    { "id": "stage", "lane": "build", "col": 3, "type": "backend", "label": "TDD stage", "sublabel": "/stage", "tag": "red→green→refactor" },
    { "id": "review", "lane": "review", "col": 4, "type": "security", "label": "Review", "sublabel": "/review", "tag": "code · security · verify" },
    { "id": "close", "lane": "review", "col": 5, "type": "backend", "label": "Close", "sublabel": "commit · archive" },
    { "id": "fix", "lane": "exceptions", "col": 4, "type": "messagebus", "label": "Resolve", "sublabel": "blockers 🔴" }
  ],
  "edges": [
    { "from": "brainstorm", "to": "plan", "variant": "default" },
    { "from": "plan", "to": "docs", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "from": "docs", "to": "stage", "variant": "default" },
    { "from": "stage", "to": "review", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "from": "review", "to": "close", "variant": "default" },
    { "from": "review", "to": "fix", "label": "findings", "variant": "security", "role": "error", "fromSide": "bottom", "toSide": "top", "route": "drop", "labelSegment": 1, "labelDy": 12 },
    { "from": "fix", "to": "stage", "label": "fix", "variant": "dashed", "role": "branch", "fromSide": "left", "toSide": "bottom", "route": "return-left" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Golden rule",
      "items": [
        "Never advance past a stage that isn't green",
        "Each stage: red → green → refactor → review + verify",
        "verify = meets the spec scenarios, one by one",
        "Human gate: Claude stops and waits for your OK per stage"
      ]
    },
    {
      "dot": "emerald",
      "title": "Durable state on disk",
      "items": [
        "spec.md (what to achieve) · docs.md (design) · tasks.md (checklist)",
        "Switch windows without losing the plan",
        "On close: the spec is archived as history (ADR)",
        "Portable and agnostic: Node, Rails, or Laravel"
      ]
    }
  ]
}
